{{ form_start(form, {'attr': {'novalidate': true, 'class': 'sa-form', 'id': 'suiviForm'}}) }}

<style>
  .sa-form table { width: 100%; border-collapse: separate; border-spacing: 0 10px; }
  .sa-form td { padding: 4px 8px; vertical-align: middle; }
  .sa-form td:first-child { width: 180px; font-size: 13px; font-weight: 600; color: #27500A; }
  .sa-form td:nth-child(2) { width: 220px; }
  .sa-form td:nth-child(3) { padding-left: 12px; }

  .sa-form input,
  .sa-form select,
  .sa-form textarea {
    background: #EAF3DE;
    border: 1px solid #C0DD97;
    border-radius: 7px;
    padding: 7px 11px;
    font-size: 13px;
    color: #27500A;
    width: 100%;
    box-sizing: border-box;
    outline: none;
    transition: border-color .2s;
  }
  .sa-form input:focus,
  .sa-form select:focus,
  .sa-form textarea:focus {
    border-color: #3B6D11;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(59,109,17,.08);
  }
  .sa-form .form-error-message {
    color: #c62828;
    font-size: 12px;
    font-weight: 600;
    margin-top: 4px;
    padding: 4px 8px;
    background: #ffebee;
    border-left: 3px solid #c62828;
    border-radius: 4px;
    display: block;
  }
  .sa-form input.is-invalid,
  .sa-form select.is-invalid,
  .sa-form textarea.is-invalid {
    border-color: #F87171 !important;
    background: #FEF2F2 !important;
  }
</style>

<table>
  {# Ligne Animal #}
  <tr>
    <td><label style="font-size:13px;font-weight:600;color:#27500A;">Animal</label></td>
    <td>
      {% if animalCode is defined and animalCode %}
        <input type="text" value="{{ animalCode }}" readonly
               style="background:#f3f4f6;border:1px solid #C0DD97;border-radius:7px;padding:7px 11px;font-size:13px;color:#27500A;width:100%;cursor:not-allowed;">
      {% elseif form.animal is defined %}
        {{ form_widget(form.animal, {'attr': {'class': form.animal.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
        {% for error in form.animal.vars.errors %}
          <span class="form-error-message">⚠ {{ error.message }}</span>
        {% endfor %}
      {% endif %}
    </td>
    <td></td>
  </tr>

  <tr>
    <td>{{ form_label(form.dateSuivi, 'Date du suivi') }}</td>
    <td>
      {{ form_widget(form.dateSuivi, {'attr': {'class': form.dateSuivi.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
      {% for error in form.dateSuivi.vars.errors %}
        <span class="form-error-message">⚠ {{ error.message }}</span>
      {% endfor %}
    </td>
    <td></td>
  </tr>
  <tr>
    <td>{{ form_label(form.temperature, 'Température (°C)') }}</td>
    <td>
      {{ form_widget(form.temperature, {'attr': {'class': form.temperature.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
      {% for error in form.temperature.vars.errors %}
        <span class="form-error-message">⚠ {{ error.message }}</span>
      {% endfor %}
    </td>
    <td></td>
  </tr>
  <tr>
    <td>{{ form_label(form.poids, 'Poids (kg)') }}</td>
    <td>
      {{ form_widget(form.poids, {'attr': {'class': form.poids.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
      {% for error in form.poids.vars.errors %}
        <span class="form-error-message">⚠ {{ error.message }}</span>
      {% endfor %}
    </td>
    <td></td>
  </tr>
  <tr>
    <td>{{ form_label(form.rythmeCardiaque, 'Rythme cardiaque (bpm)') }}</td>
    <td>
      {{ form_widget(form.rythmeCardiaque, {'attr': {'class': form.rythmeCardiaque.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
      {% for error in form.rythmeCardiaque.vars.errors %}
        <span class="form-error-message">⚠ {{ error.message }}</span>
      {% endfor %}
    </td>
    <td></td>
  </tr>
  <tr>
    <td>{{ form_label(form.niveauActivite, "Niveau d'activité") }}</td>
    <td>
      {{ form_widget(form.niveauActivite, {'attr': {'class': form.niveauActivite.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
      {% for error in form.niveauActivite.vars.errors %}
        <span class="form-error-message">⚠ {{ error.message }}</span>
      {% endfor %}
    </td>
    <td></td>
  </tr>
  <tr>
    <td>{{ form_label(form.etatSante, 'État de santé') }}</td>
    <td>
      {{ form_widget(form.etatSante, {'attr': {'class': form.etatSante.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
      {% for error in form.etatSante.vars.errors %}
        <span class="form-error-message">⚠ {{ error.message }}</span>
      {% endfor %}
    </td>
    <td></td>
  </tr>
  <tr>
    <td>{{ form_label(form.remarque, 'Remarque') }}</td>
    <td>{{ form_widget(form.remarque) }}</td>
    <td></td>
  </tr>
</table>

<div style="margin-top:16px;">
  <button type="submit" class="btn" style="background:#3B6D11;color:white;border:none;padding:9px 22px;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;">
    {{ button_label|default('Enregistrer') }}
  </button>
</div>

{{ form_end(form) }}
