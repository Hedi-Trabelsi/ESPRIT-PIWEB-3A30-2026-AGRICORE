{% extends 'front/base_front.html.twig' %}
{% block title %}Nouvel Animal{% endblock %}

{% block body %}
<div style="max-width:780px;margin:0 auto;padding:2rem 2.5rem;">

  {# ── Header ── #}
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem;padding-bottom:1rem;border-bottom:2px solid #C0DD97;">
    <div style="display:flex;align-items:center;gap:12px;">
      <div style="width:42px;height:42px;background:linear-gradient(135deg,#3B6D11,#639922);border-radius:12px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(59,109,17,.3);">
        <span style="font-size:20px;">🐾</span>
      </div>
      <div>
        <h1 style="font-size:22px;font-weight:700;color:#27500A;margin:0;">Nouvel animal</h1>
        <p style="font-size:13px;color:#639922;margin:0;">Enregistrement dans le cheptel</p>
      </div>
    </div>
    <a href="{{ path('app_animal_index') }}"
       style="background:transparent;color:#3B6D11;border:1.5px solid #3B6D11;padding:8px 16px;border-radius:9px;font-size:13px;font-weight:600;text-decoration:none;">
      ← Retour à la liste
    </a>
  </div>

  {# ── Carte formulaire ── #}
  <div style="background:#fff;border:1px solid #d4edba;border-radius:20px;overflow:hidden;box-shadow:0 8px 32px rgba(59,109,17,.08);">

    <div style="background:linear-gradient(135deg,#EAF3DE,#d4edba);padding:18px 24px;border-bottom:1px solid #C0DD97;display:flex;align-items:center;gap:10px;">
      <span style="font-size:22px;">📋</span>
      <div>
        <p style="font-size:15px;font-weight:700;color:#27500A;margin:0;">Informations de l'animal</p>
        <p style="font-size:12px;color:#639922;margin:0;">Tous les champs sont obligatoires</p>
      </div>
    </div>

    {{ form_start(form, {'attr': {'novalidate': true, 'style': 'padding:24px;'}}) }}

    <style>
      .af-row { margin-bottom:18px; }
      .af-label { display:block;font-size:12px;font-weight:700;color:#639922;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px; }
      .af-input { width:100%;background:#f8fdf4;border:1.5px solid #C0DD97;border-radius:10px;padding:11px 14px;font-size:14px;color:#27500A;box-sizing:border-box;outline:none;transition:all .2s; }
      .af-input:focus { border-color:#3B6D11;background:#fff;box-shadow:0 0 0 4px rgba(59,109,17,.08); }
      .af-error { color:#dc2626;font-size:12px;font-weight:600;margin-top:5px;padding:5px 10px;background:#fff1f2;border-left:3px solid #dc2626;border-radius:4px;display:block; }
      .af-grid-2 { display:grid;grid-template-columns:1fr 1fr;gap:18px; }
      @media(max-width:600px){ .af-grid-2{grid-template-columns:1fr;} }
    </style>

    {# Ligne 1 : Code + Espèce #}
    <div class="af-grid-2 af-row">
      <div>
        <label class="af-label">🏷️ Code animal</label>
        {{ form_widget(form.codeAnimal, {'attr': {'class': 'af-input', 'placeholder': 'ex: A001'}}) }}
        {% for error in form.codeAnimal.vars.errors %}<span class="af-error">⚠ {{ error.message }}</span>{% endfor %}
      </div>
      <div>
        <label class="af-label">🐄 Espèce</label>
        {{ form_widget(form.espece, {'attr': {'class': 'af-input', 'placeholder': 'ex: Bovin, Ovin...'}}) }}
        {% for error in form.espece.vars.errors %}<span class="af-error">⚠ {{ error.message }}</span>{% endfor %}
      </div>
    </div>

    {# Ligne 2 : Race + Sexe #}
    <div class="af-grid-2 af-row">
      <div>
        <label class="af-label">🧬 Race</label>
        {{ form_widget(form.race, {'attr': {'class': 'af-input', 'placeholder': 'ex: Holstein, Mérinos...'}}) }}
        {% for error in form.race.vars.errors %}<span class="af-error">⚠ {{ error.message }}</span>{% endfor %}
      </div>
      <div>
        <label class="af-label">⚧️ Sexe</label>
        {{ form_widget(form.sexe, {'attr': {'class': 'af-input'}}) }}
        {% for error in form.sexe.vars.errors %}<span class="af-error">⚠ {{ error.message }}</span>{% endfor %}
      </div>
    </div>

    {# Ligne 3 : Date de naissance #}
    <div class="af-row">
      <label class="af-label">📅 Date de naissance</label>
      {{ form_widget(form.dateNaissance, {'attr': {'class': 'af-input'}}) }}
      {% for error in form.dateNaissance.vars.errors %}<span class="af-error">⚠ {{ error.message }}</span>{% endfor %}
    </div>

    {# Footer #}
    <div style="display:flex;justify-content:space-between;align-items:center;padding-top:16px;border-top:1px solid #e8f5d8;margin-top:8px;">
      <button type="submit"
              style="background:linear-gradient(135deg,#3B6D11,#639922);color:white;border:none;padding:12px 28px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:8px;box-shadow:0 4px 14px rgba(59,109,17,.3);">
        ✅ Enregistrer l'animal
      </button>
      <a href="{{ path('app_animal_index') }}"
         style="color:#6c757d;font-size:13px;text-decoration:none;padding:8px 16px;border:1px solid #e5e7eb;border-radius:9px;">
        Annuler
      </a>
    </div>

    {{ form_end(form) }}
  </div>

</div>
{% endblock %}
