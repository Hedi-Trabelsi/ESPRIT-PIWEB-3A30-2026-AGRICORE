{{ form_start(form, {'attr': {'id': 'animalForm', 'novalidate': 'novalidate'}}) }}

<style>
.field-error-msg {
  display: none;
  color: #c62828;
  font-size: 12px;
  font-weight: 600;
  margin-top: 4px;
  padding: 4px 8px;
  background: #ffebee;
  border-left: 3px solid #c62828;
  border-radius: 4px;
}
.ag-input.input-error {
  border-color: #F87171 !important;
  background: #fff5f5 !important;
}
</style>

<div class="ag-form-body">
  <div class="ag-form-grid">
    {% for field in form.children %}
      {% if field.vars.name != '_token' %}
      <div class="ag-field {% if field.vars.block_prefixes|join(' ') matches '/textarea|date/' %}full{% endif %}">
        <label class="ag-label" for="{{ field.vars.id }}">
          {{ field.vars.label|default(field.vars.name|replace({'_': ' '})|capitalize) }}
        </label>
        {{ form_widget(field, {'attr': {'class': 'ag-input' ~ (field.vars.block_prefixes|join(' ') matches '/choice|select/' ? ' ag-select' : ''), 'id': field.vars.id}}) }}
        <div class="field-error-msg" id="err-{{ field.vars.name }}"></div>
        {% if field.vars.errors|length > 0 %}
          {% for error in field.vars.errors %}
            <div class="field-error-msg" style="display:block;">⚠ {{ error.message }}</div>
          {% endfor %}
        {% endif %}
      </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<div class="ag-form-footer">
  <div style="display:flex;gap:8px;">
    <button type="submit" class="ag-btn-save">
      <i class="fas fa-save"></i>
      {{ button_label|default('Enregistrer') }}
    </button>
    <a href="{{ path('app_animal_index') }}" class="ag-btn-back">Annuler</a>
  </div>
  {% block delete_action %}{% endblock %}
</div>

{{ form_end(form) }}

<script>
document.getElementById('animalForm').addEventListener('submit', function(e) {
  var hasError = false;

  var fields = [
    { id: 'animal_codeAnimal', name: 'codeAnimal',    msg: 'Le code animal est obligatoire.' },
    { id: 'animal_espece',     name: 'espece',         msg: "L'espèce est obligatoire." },
    { id: 'animal_race',       name: 'race',           msg: 'La race est obligatoire.' },
    { id: 'animal_sexe',       name: 'sexe',           msg: 'Le sexe est obligatoire.' },
    { id: 'animal_dateNaissance', name: 'dateNaissance', msg: 'La date de naissance est obligatoire.' },
  ];

  fields.forEach(function(f) {
    var input = document.getElementById(f.id);
    var errDiv = document.getElementById('err-' + f.name);
    if (!input || !errDiv) return;

    input.classList.remove('input-error');
    errDiv.style.display = 'none';
    errDiv.textContent = '';

    if (!input.value || !input.value.trim()) {
      input.classList.add('input-error');
      errDiv.textContent = '⚠ ' + f.msg;
      errDiv.style.display = 'block';
      hasError = true;
    }
  });

  if (hasError) {
    e.preventDefault();
    // Scroll vers la première erreur
    var first = document.querySelector('.input-error');
    if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
});

// Effacer l'erreur quand l'utilisateur tape
document.querySelectorAll('.ag-input').forEach(function(input) {
  input.addEventListener('input', function() {
    this.classList.remove('input-error');
    var name = this.id.replace('animal_', '');
    var errDiv = document.getElementById('err-' + name);
    if (errDiv) { errDiv.style.display = 'none'; errDiv.textContent = ''; }
  });
});
</script>