{% for animal in animals %}

{# ── Emoji par espèce ── #}
{% set espece_lower = animal.espece|lower %}
{% if 'vache' in espece_lower or 'bovin' in espece_lower %}
  {% set emoji = '🐄' %}
{% elseif 'cheval' in espece_lower or 'equin' in espece_lower or 'poney' in espece_lower %}
  {% set emoji = '🐴' %}
{% elseif 'mouton' in espece_lower or 'brebis' in espece_lower or 'ovin' in espece_lower %}
  {% set emoji = '🐑' %}
{% elseif 'chèvre' in espece_lower or 'chevre' in espece_lower or 'caprin' in espece_lower %}
  {% set emoji = '🐐' %}
{% elseif 'porc' in espece_lower or 'truie' in espece_lower or 'porcin' in espece_lower %}
  {% set emoji = '🐷' %}
{% elseif 'poulet' in espece_lower or 'poule' in espece_lower or 'volaille' in espece_lower %}
  {% set emoji = '🐔' %}
{% elseif 'lapin' in espece_lower %}
  {% set emoji = '🐰' %}
{% elseif 'chien' in espece_lower or 'canin' in espece_lower %}
  {% set emoji = '🐕' %}
{% elseif 'chat' in espece_lower or 'felin' in espece_lower %}
  {% set emoji = '🐈' %}
{% elseif 'canard' in espece_lower %}
  {% set emoji = '🦆' %}
{% elseif 'dinde' in espece_lower %}
  {% set emoji = '🦃' %}
{% elseif 'âne' in espece_lower or 'ane' in espece_lower %}
  {% set emoji = '🫏' %}
{% else %}
  {% set emoji = '🐾' %}
{% endif %}

<div class="ag-card" style="border-radius:18px;overflow:hidden;background:#fff;border:1px solid #d4edba;box-shadow:0 4px 18px rgba(59,109,17,0.07);transition:transform .2s,box-shadow .2s;margin:0 4px;">
  <div style="background:linear-gradient(135deg,#EAF3DE,#d4edba);padding:22px 18px 16px;text-align:center;position:relative;">
    {# Boutons edit/delete en haut à droite #}
    <div style="position:absolute;top:10px;right:10px;display:flex;gap:5px;">
      <a href="{{ path('app_animal_edit', {'idAnimal': animal.idAnimal}) }}"
         title="Modifier"
         style="width:28px;height:28px;border-radius:8px;background:rgba(255,255,255,0.8);color:#3B6D11;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;border:1px solid #C0DD97;backdrop-filter:blur(4px);">
        <i class="fas fa-pen" style="font-size:10px;"></i>
      </a>
      <form method="post" action="{{ path('app_animal_delete', {'idAnimal': animal.idAnimal}) }}" style="margin:0;">
        <button type="submit" title="Supprimer"
                style="width:28px;height:28px;border-radius:8px;background:rgba(255,255,255,0.8);color:#A32D2D;display:inline-flex;align-items:center;justify-content:center;border:1px solid #ffcdd2;cursor:pointer;backdrop-filter:blur(4px);">
          <i class="fas fa-trash-alt" style="font-size:10px;"></i>
        </button>
      </form>
    </div>

    {# Badge code #}
    <div style="position:absolute;top:10px;left:10px;">
      <span style="background:#3B6D11;color:white;font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;letter-spacing:.5px;">#{{ animal.codeAnimal }}</span>
    </div>

    {# Emoji espèce #}
    <div style="font-size:52px;line-height:1;margin-bottom:8px;filter:drop-shadow(0 2px 6px rgba(0,0,0,.1));">{{ emoji }}</div>
    <p style="font-size:18px;font-weight:700;color:#27500A;margin:0 0 4px;">{{ animal.race }}</p>
    <span style="background:#3B6D11;color:white;font-size:11px;font-weight:600;padding:3px 12px;border-radius:20px;">{{ animal.espece }}</span>
  </div>

  <div style="padding:16px 18px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;">
      <div style="background:#f8fdf4;border-radius:10px;padding:10px 12px;border:1px solid #e8f5d8;">
        <div style="font-size:10px;color:#639922;text-transform:uppercase;letter-spacing:.5px;font-weight:600;margin-bottom:4px;">Sexe</div>
        <div style="font-size:14px;font-weight:600;color:{{ animal.sexe == 'Mâle' ? '#185FA5' : '#993556' }};">
          {{ animal.sexe == 'Mâle' ? '♂️' : '♀️' }} {{ animal.sexe }}
        </div>
      </div>
      <div style="background:#f8fdf4;border-radius:10px;padding:10px 12px;border:1px solid #e8f5d8;">
        <div style="font-size:10px;color:#639922;text-transform:uppercase;letter-spacing:.5px;font-weight:600;margin-bottom:4px;">Né le</div>
        <div style="font-size:13px;font-weight:600;color:#27500A;">
          📅 {{ animal.dateNaissance ? animal.dateNaissance|date('d/m/Y') : '-' }}
        </div>
      </div>
    </div>
  </div>

  <div style="padding:0 18px 16px;">
    <a href="{{ path('app_animal_show', {'idAnimal': animal.idAnimal}) }}"
       style="display:block;width:100%;text-align:center;padding:10px;border:2px solid #3B6D11;color:#3B6D11;border-radius:10px;font-size:13px;font-weight:600;background:transparent;text-decoration:none;transition:all .2s;"
       onmouseover="this.style.background='#3B6D11';this.style.color='white';"
       onmouseout="this.style.background='transparent';this.style.color='#3B6D11';">
      👁️ Voir la fiche
    </a>
  </div>
</div>

{% else %}
<div style="grid-column:1/-1;text-align:center;padding:4rem 2rem;color:#639922;background:#f8fdf4;border-radius:16px;border:2px dashed #C0DD97;">
  <div style="font-size:56px;margin-bottom:1rem;">🐾</div>
  <p style="font-size:16px;font-weight:600;color:#27500A;">Aucun animal trouvé</p>
  <p style="font-size:13px;color:#639922;">Essayez de modifier vos critères de recherche</p>
</div>
{% endfor %}
