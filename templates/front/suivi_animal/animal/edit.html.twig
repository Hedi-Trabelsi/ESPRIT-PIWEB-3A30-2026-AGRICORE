{% extends 'front/base_front.html.twig' %}
{% block title %}Modifier Animal{% endblock %}

{% block body %}
<div style="max-width:780px;margin:0 auto;padding:2rem 2.5rem;">

  {# ── Header ── #}
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem;padding-bottom:1rem;border-bottom:2px solid #C0DD97;">
    <div style="display:flex;align-items:center;gap:12px;">
      <div style="width:42px;height:42px;background:linear-gradient(135deg,#b45309,#d97706);border-radius:12px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(180,83,9,.3);">
        <span style="font-size:20px;">✏️</span>
      </div>
      <div>
        <h1 style="font-size:22px;font-weight:700;color:#27500A;margin:0;">Modifier l'animal</h1>
        <p style="font-size:13px;color:#639922;margin:0;">Mise à jour — <strong>#{{ animal.codeAnimal }}</strong></p>
      </div>
    </div>
    <a href="{{ path('app_animal_index') }}"
       style="background:transparent;color:#3B6D11;border:1.5px solid #3B6D11;padding:8px 16px;border-radius:9px;font-size:13px;font-weight:600;text-decoration:none;">
      ← Retour à la liste
    </a>
  </div>

  {# ── Carte formulaire ── #}
  <div style="background:#fff;border:1px solid #fde68a;border-radius:20px;overflow:hidden;box-shadow:0 8px 32px rgba(180,83,9,.08);">

    <div style="background:linear-gradient(135deg,#fff8e1,#fef3c7);padding:18px 24px;border-bottom:1px solid #fde68a;display:flex;align-items:center;gap:10px;">
      <span style="font-size:22px;">📝</span>
      <div>
        <p style="font-size:15px;font-weight:700;color:#92400e;margin:0;">Modification de l'animal</p>
        <p style="font-size:12px;color:#b45309;margin:0;">Modifiez les informations ci-dessous</p>
      </div>
    </div>

    <form method="post" action="{{ path('app_animal_edit', {'idAnimal': animal.idAnimal}) }}" style="padding:24px;">

      <style>
        .af-row { margin-bottom:18px; }
        .af-label { display:block;font-size:12px;font-weight:700;color:#639922;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px; }
        .af-input { width:100%;background:#f8fdf4;border:1.5px solid #C0DD97;border-radius:10px;padding:11px 14px;font-size:14px;color:#27500A;box-sizing:border-box;outline:none;transition:all .2s; }
        .af-input:focus { border-color:#3B6D11;background:#fff;box-shadow:0 0 0 4px rgba(59,109,17,.08); }
        .af-grid-2 { display:grid;grid-template-columns:1fr 1fr;gap:18px; }
        @media(max-width:600px){ .af-grid-2{grid-template-columns:1fr;} }
      </style>

      <div class="af-grid-2 af-row">
        <div>
          <label class="af-label">🏷️ Code animal</label>
          <input type="text" name="codeAnimal" class="af-input" required value="{{ animal.codeAnimal }}">
        </div>
        <div>
          <label class="af-label">🐄 Espèce</label>
          <input type="text" name="espece" class="af-input" required value="{{ animal.espece }}">
        </div>
      </div>

      <div class="af-grid-2 af-row">
        <div>
          <label class="af-label">🧬 Race</label>
          <input type="text" name="race" class="af-input" required value="{{ animal.race }}">
        </div>
        <div>
          <label class="af-label">⚧️ Sexe</label>
          <select name="sexe" class="af-input" required>
            <option value="Mâle"    {% if animal.sexe == 'Mâle'    %}selected{% endif %}>♂️ Mâle</option>
            <option value="Femelle" {% if animal.sexe == 'Femelle' %}selected{% endif %}>♀️ Femelle</option>
          </select>
        </div>
      </div>

      <div class="af-row">
        <label class="af-label">📅 Date de naissance</label>
        <input type="date" name="dateNaissance" class="af-input" required
               value="{{ animal.dateNaissance ? animal.dateNaissance|date('Y-m-d') : '' }}"
               max="{{ "now"|date('Y-m-d') }}">
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;padding-top:16px;border-top:1px solid #e8f5d8;margin-top:8px;">
        <button type="submit"
                style="background:linear-gradient(135deg,#b45309,#d97706);color:white;border:none;padding:12px 28px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:8px;box-shadow:0 4px 14px rgba(180,83,9,.3);">
          💾 Mettre à jour
        </button>
        <a href="{{ path('app_animal_show', {'idAnimal': animal.idAnimal}) }}"
           style="color:#6c757d;font-size:13px;text-decoration:none;padding:8px 16px;border:1px solid #e5e7eb;border-radius:9px;">
          Annuler
        </a>
      </div>

    </form>
  </div>

  {# ── Zone suppression ── #}
  <div style="margin-top:1.5rem;padding:16px 20px;background:#fff1f2;border:1px solid #fecaca;border-radius:14px;display:flex;justify-content:space-between;align-items:center;">
    <div>
      <p style="font-size:14px;font-weight:700;color:#dc2626;margin:0;">🗑️ Zone de suppression</p>
      <p style="font-size:12px;color:#ef4444;margin:0;">Cette action supprimera l'animal et tous ses suivis</p>
    </div>
    <form method="post" action="{{ path('app_animal_delete', {'idAnimal': animal.idAnimal}) }}">
      <button type="submit"
              style="background:transparent;color:#dc2626;border:1.5px solid #dc2626;padding:9px 18px;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;"
              onclick="return confirm('Supprimer cet animal ?')">
        🗑️ Supprimer
      </button>
    </form>
  </div>

</div>
{% endblock %}
