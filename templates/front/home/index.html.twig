<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const openBtn = document.getElementById('openCalendarBtn');
    const closeBtn = document.getElementById('closeCalendarBtn');
    const overlay = document.getElementById('calendarModalOverlay');
    let calendar = null;
    let calendarInit = false;
    let tooltip = null;

    openBtn.addEventListener('click', function() {
        overlay.style.display = 'flex';
        if (!calendarInit) {
            initCalendar();
            calendarInit = true;
        } else {
            calendar.updateSize();
        }
    });

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', function(e) {
        if (e.target === overlay) {
            closeModal();
        }
    });

    function closeModal() {
        overlay.style.display = 'none';
        removeTooltip();
    }

    function initCalendar() {
        const events = {{ calendarEvents|json_encode|raw }};
        
        events.forEach(event => {
            if (event.type === 'event') {
                event.title = '<i class="fas fa-star event-star"></i> ' + event.title;
                event.className = 'event-type-event';
                event.color = '#3b82f6';
            } else if (event.type === 'maintenance') {
                event.title = '<i class="fas fa-wrench event-icon"></i> ' + event.title;
                event.className = 'event-type-maintenance';
                event.color = '#f97316';
            }
        });

        calendar = new FullCalendar.Calendar(document.getElementById('homeCalendar'), {
            initialView: 'dayGridMonth',
            locale: 'fr',
            height: 'auto',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,listMonth'
            },
            buttonText: {
                today: "Aujourd'hui",
                month: 'Mois',
                week: 'Semaine',
                list: 'Liste'
            },
            events: events,
            eventContent: function(arg) {
                return {
                    html: arg.event.title
                };
            },
            eventClick: function(info) {
                info.jsEvent.preventDefault();
            },
            eventMouseEnter: function(info) {
                removeTooltip();
                const props = info.event.extendedProps;
                tooltip = document.createElement('div');
                tooltip.className = 'fc-tooltip';
                
                let typeIcon, typeClass;
                if (info.event.extendedProps.type === 'event') {
                    typeIcon = '<i class="fas fa-calendar-check"></i>';
                    typeClass = 'tr-type-event';
                } else {
                    typeIcon = '<i class="fas fa-tools"></i>';
                    typeClass = 'tr-type-maintenance';
                }
                
                tooltip.innerHTML = `
                    <h6>${typeIcon} ${info.event.title.replace(/<[^>]*>/g, '')}</h6>
                    <div class="tr ${typeClass}"><i class="fas fa-tag"></i> ${info.event.extendedProps.type === 'event' ? 'Événement' : 'Maintenance'}</div>
                    ${props.lieu ? `<div class="tr"><i class="fas fa-map-marker-alt"></i> ${props.lieu}</div>` : ''}
                    ${props.equipement ? `<div class="tr"><i class="fas fa-cog"></i> ${props.equipement}</div>` : ''}
                    ${props.description ? `<div class="tr"><i class="fas fa-info-circle"></i> ${props.description.substring(0, 60)}${props.description.length > 60 ? '...' : ''}</div>` : ''}
                `;
                document.body.appendChild(tooltip);
                posTooltip(info.jsEvent);
            },
            eventMouseLeave: removeTooltip,
        });
        
        calendar.render();
        
        document.addEventListener('mousemove', function(e) {
            if (tooltip) posTooltip(e);
        });
    }
    
    function posTooltip(e) {
        if (!tooltip) return;
        const x = e.clientX + 20, y = e.clientY + 20;
        tooltip.style.left = (x + tooltip.offsetWidth  > window.innerWidth  ? x - tooltip.offsetWidth  - 40 : x) + 'px';
        tooltip.style.top  = (y + tooltip.offsetHeight > window.innerHeight ? y - tooltip.offsetHeight - 40 : y) + 'px';
    }
    
    function removeTooltip() {
        if (tooltip) {
            tooltip.remove();
            tooltip = null;
        }
    }
});
</script>
